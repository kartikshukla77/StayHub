
<% layout('/layouts/boilerplate') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="booking-box">
                <h3 class="booking-title">Complete Your Booking</h3>

                <div class="row p-4">
                    <div class="col-md-5 mb-3">
                        <img src="<%= listing.image.url %>" class="booking-img" alt="listing_image">
                        <h5 class="mt-3"><%= listing.title %></h5>
                        <p><%= listing.location %>, <%= listing.country %></p>
                        <h5>₹<%= listing.price.toLocaleString("en-IN") %></h5>
                    </div>

                    <div class="col-md-7">
                        <form action="/listings/<%= listing._id %>/book" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Card Holder Name</label>
                                <input class="form-control booking-input" type="text" name="cardName" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Card Number</label>
                                <input class="form-control booking-input" type="text" maxlength="16" name="cardNumber" required>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label">Expiry</label>
                                    <input class="form-control booking-input" type="month" name="expiry" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">CVV</label>
                                    <input class="form-control booking-input" type="password" maxlength="3" name="cvv" required>
                                </div>
                            </div>

                            <button class="booking-btn mt-4">
                                Pay ₹<%= listing.price.toLocaleString("en-IN") %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>