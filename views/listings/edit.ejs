<% layout('/layouts/boilerplate') %>
   

      <div class="row">
         <div class="col-8 offset-2" >
         <br>
        <h3  class="adj-margin" >Edit your list </h3>
         <br>
           <form action="/listings/<%= data._id%>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

          <div class="mb-3">    
            <label for="title" class="form-label">Title</label>
            <input type="text" value=" <%= data.title %> " name="listing[title]" id="" class="form-control" required> 
             <div class="invalid-feedback">
                    Enter a title.
                </div>
                <div class="valid-feedback">
                    Tital looks amazing!
                </div>
          </div>
        
          <div class="mb-3" >  
             <label for="description" class="form-label">Description</label>
             <textarea type="text" name="listing[description]" id="" class="form-control" required><%= data.description %></textarea>
             <div class="invalid-feedback">
                    Add a description.
                </div>
          </div>

          <div class="mb-3" >
             <img src="<%=originalImageUrl%>" alt="">
            
          </div>

          <div class="mb-3" >
            <label for="image" class="form-label">Upload Image</label>
             <input type="file"  name="listing[image]" id="" class="form-control"> 
            
          </div>


          <div class="row">

          <div class="mb-3 col-md-4" >
            <label for="price" class="form-label">Price</label>
            <input type="number" value="<%= data.price %>" name="listing[price]" id="" class="form-control" required> 
             <div class="invalid-feedback">
                        Enter a price.
                     </div>
          </div>
           
          
           <div class="mb-3 col-md-8 ">
            <label for="country" class="form-label">Country</label>
            <input type="text" value=" <%= data.country %> " name="listing[country]" id="" class="form-control" required> 
            <div class="invalid-feedback">
                         Enter a country name.
                        </div>
          </div>

          </div>

          <div class="mb-3" >
            <label for="location" class="form-label">Location</label>
            <input type="text" value=" <%= data.location %> " name="listing[location]" id="" class="form-control" required>
             <div class="invalid-feedback">
                    Enter a location.
                </div>
          </div>

          
  <div class="mb-3">
    <label for="category" class="form-label">Category</label>
    <select
        name="listing[category]"
        id="category"
        class="form-select"
        required
    >
        <option value="" selected disabled>Select a category</option>
        <option value="Trending">🔥 Trending</option>
        <option value="Rooms">🛏️ Rooms</option>
        <option value="Iconic Cities">🏙️ Iconic Cities</option>
        <option value="Mountains">⛰️ Mountains</option>
        <option value="Castles">🏰 Castles</option>
        <option value="Amazing pools">🏊 Amazing Pools</option>
        <option value="Camping">🏕️ Camping</option>
        <option value="Farms">🐄 Farms</option>
        <option value="Arctic">❄️ Arctic</option>
        <option value="Domes">🏕️ Domes</option>
        <option value="Boat">🚤 Boat</option>
    </select>

    <div class="invalid-feedback">
        Select a category.
    </div>
</div>         





          
          <br><br>
         <button type="submit" class="btn btn-dark edit-btn">Edit</button>
         <br><br>

         </form>
     </div>
   </div>      
    
