<form action="/listings/category" method="GET">

   <div id="filters">

    <div class="filter">
      <button type="submit" name="category" value="Trending">
        <i class="fa-solid fa-fire"></i>
      </button>
      <p>Trending</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Rooms">
        <i class="fa-solid fa-bed"></i>
      </button>
      <p>Rooms</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Iconic Cities">
        <i class="fa-solid fa-mountain-city"></i>
      </button>
      <p>Iconic Cities</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Mountains">
        <i class="fa-solid fa-mountain"></i>
      </button>
      <p>Mountains</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Castles">
        <i class="fa-solid fa-fort-awesome"></i>
      </button>
      <p>Castles</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Amazing pools">
        <i class="fa-solid fa-person-swimming"></i>
      </button>
      <p>Amazing pools</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Camping">
        <i class="fa-solid fa-campground"></i>
      </button>
      <p>Camping</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Farms">
        <i class="fa-solid fa-cow"></i>
      </button>
      <p>Farms</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Arctic">
        <i class="fa-solid fa-snowflake"></i>
      </button>
      <p>Arctic</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Domes">
        <i class="fa-solid fa-igloo"></i>
      </button>
      <p>Domes</p>
    </div>

    <div class="filter">
      <button type="submit" name="category" value="Boat">
        <i class="fa-solid fa-ship"></i>
      </button>
      <p>Boat</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>

    </div>
</form>





<div class="row row-cols-sm-1 row-cols-md-2 row-cols-lg-3 mt-3">

   <% for(let list of data){ %>
    
    <a href="/listings/<%= list._id%>" class="listing_link"> 

    <div class="card col listing-card"> 
           <img class="card-img-top" src="<%=list.image.url%>" alt="listing_image" style="height: 20rem; "/>

           <div class="card-img-overlay"> </div>

        <div class="card-body">
            <p class="card-text">
                 <b><%= list.title %></b>  <br>
                &#8377;<%= list.price.toLocaleString('en-IN') %>/night <br>
                <i class="tax-info"> &nbsp; &nbsp; +18%GST</i>
            </p>
        </div>
          
    </div>
</a>
    <%  }  %>

 </div>
  
<script src="/js/filter.js"> </script>





