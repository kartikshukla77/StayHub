<% layout('/layouts/boilerplate') %>


<h3>ALL LISTINGS</h3>
<br>
<div class="row row-cols-sm-1 row-cols-md-2 row-cols-lg-3">

   <% for(let list of data){ %>
    
    <a href="/listings/<%= list._id%>" class="listing_link"> 

    <div class="card col"> 
           <img class="card-img-top" src="<%=list.image%>" alt="listing_image" style="height: 20rem; "/>

           <div class="card-img-overlay"> </div>

        <div class="card-body">
            <p class="card-text">
                 <b><%= list.title %></b>  <br>
                &#8377;<%= list.price.toLocaleString('en-IN') %>/night <br>
            </p>
        </div>
          
    </div>
</a>
    <%  }  %>

 </div>
  

