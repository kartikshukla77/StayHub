<% layout('/layouts/boilerplate') %>
<div class="row mt-3">
    <div class="col-8 offset-3">
      <h3><%=data.title%></h3>
    </div>
        <div class="card col-6 offset-3 show-card listing-card">
  <img  src="<%=data.image%>" class=" card-img-top show-img" alt="listing_image">
  <div class="card-body">
    <p class="card-text"><i> <%= data.owner.username %></i></p>
    <p class="card-text"> <%= data.description %> </p>
    <p class="card-text">  &#8377;<%= data.price.toLocaleString('en-IN') %> </p>
    <p class="card-text"> <%=data.location%> </p>
    <p class="card-text">  <%= data.country %></p>
    
  </div>
</div>

  

<br>

<div class="btns">
     <a href="/listings/<%=data._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn" > Edit</a>

     <form action="/listings/<%=data._id%>/delete?_method=DELETE" method="post">
        <button class="btn btn-dark offset-5" >Delete</button>
    </form>

</div>

  



   <div class="col-8 offset-3 mb-3">
    <hr>
    <h4> Leave a Review</h4>
     <form action="/listings/<%=data._id%>/reviews" method="post" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" >
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="" cols="30" rows="5" class="form-control" required></textarea>
             <div class="invalid-feedback">
                    Please add a Feedback.
                </div>
            
        </div>
        <button class="btn btn-outline-dark" type="submit">Submit</button>
     </form>
          <hr>



          <p><b>All reviews</b></p>
          <div class="row">
           <% for (review of data.reviews){ %> 
                <div class="card col-5 ms-3 mb-3">
                 <div class="card-body">
                  <h5 class="card-title">Admin</h5>
                  <p class="card-text"><%=review.comment%></p>
                  <p class="card-text"><%=review.rating%>Stars</p>

                  <form method="post" action="/listings/<%= data._id%>/reviews/<%= review._id%>?_method=DELETE" class="mb-3">
                  <button class="btn btn-sm btn-dark">Delete</button>
                 </form>
                 </div>

                 
                </div>
           <% } %>
          </div>
 
   </div>
</div> 

